# Copy to .env:  cp .env.example .env
# Values below match docker-compose.yml and are for local development only.

DATABASE_URL=postgres://mailbox:mailbox@localhost:5432/mailbox
# Used only by `npm run test:integration` (database is created by docker/init-test-db.sql)
TEST_DATABASE_URL=postgres://mailbox:mailbox@localhost:5432/mailbox_test

# --- Worker ---
WORKER_POLL_INTERVAL_MS=1000
# A PROVISIONING order whose lease is older than this is considered abandoned
# (worker crashed) and is moved to FAILED so an admin can retry it.
WORKER_LEASE_MS=60000
# How many mailboxes of one order are provisioned in parallel.
WORKER_MAILBOX_CONCURRENCY=5

# --- Mock providers ---
PROVIDER_FAILURE_RATE=0.2
PROVIDER_MIN_LATENCY_MS=1000
PROVIDER_MAX_LATENCY_MS=3000
